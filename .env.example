# ==========================================
# RAHBAR SYSTEM ENVIRONMENT CONFIGURATION
# Copy to .env and fill in your values.
# NEVER commit .env to GitHub!
# ==========================================

# ------------------------------------------
# 1. SUPABASE (Managed by Naresh)
# ------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Direct Postgres URI for SQLAlchemy & Alembic migrations:
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------
# 2. AI & LLM PROVIDERS (Managed by Naresh)
# ------------------------------------------
# Primary LLM (Llama 70B) & Urdu Speech-to-Text (Whisper large-v3)
GROQ_API_KEY=gsk_...

# Secondary Fallback LLM
GEMINI_API_KEY=AIzaSy...

# Tertiary Fallback LLM (Free-tier open models)
OPENROUTER_API_KEY=sk-or-v1-...

# ------------------------------------------
# 3. BACKEND & SECURITY (Managed by Mahandar)
# ------------------------------------------
JWT_SECRET=generate_a_random_32_char_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mock Services API Key (Shared internal secret)
MOCK_SERVICES_API_KEY=mock-internal-secret-key-12345

# ------------------------------------------
# 4. OBSERVABILITY & EVALUATION (Optional)
# ------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
