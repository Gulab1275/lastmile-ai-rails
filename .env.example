# ==============================================================================
# RAHBAR SYSTEM ENVIRONMENT CONFIGURATION (.env.example)
# Digital Public Infrastructure (DPI) Prototype - Coder's Cup '26
# Team: Mahandar (Backend & AWS Infra), Naresh (AI & DB), Gulab (Frontend & PWA)
# Copy to .env and fill in your values. NEVER commit .env to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BACKEND SECURITY (Managed by Mahandar)
# ------------------------------------------------------------------------------
APP_NAME=Rahbar
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

SECRET_KEY=rahbar-super-secret-development-key-change-in-production-min32chars
JWT_SECRET=rahbar-super-secret-development-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Domain
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://rahbar.duckdns.org","https://rahbar-backend.duckdns.org","https://rahbar-pwa.vercel.app","https://lastmile-ai-rails.vercel.app"]
DOMAIN=rahbar.duckdns.org

# Rate Limiting (SlowAPI)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AI_INTENSIVE=30/minute

# ------------------------------------------------------------------------------
# 2. DATABASE & SUPABASE (Managed by Naresh)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://rhlvnyqgrbjsvlbzljhz.supabase.co
SUPABASE_ANON_KEY=mock-supabase-anon-key-for-development
SUPABASE_SERVICE_ROLE_KEY=mock-supabase-service-role-key-for-development
SUPABASE_SERVICE_KEY=mock-supabase-service-role-key-for-development
# Direct Postgres URI for SQLAlchemy & Alembic migrations:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rahbar

# ------------------------------------------------------------------------------
# 3. AI & LLM PROVIDERS (Managed by Naresh)
# ------------------------------------------------------------------------------
# Primary LLM (Llama 70B) & Urdu Speech-to-Text (Whisper large-v3)
GROQ_API_KEY=mock_groq_api_key

# Secondary Fallback LLM
GEMINI_API_KEY=mock_gemini_api_key

# Tertiary Fallback LLM (Free-tier open models)
OPENROUTER_API_KEY=mock_openrouter_api_key

# AWS Bedrock Fallback & Cloud Deployment
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. MOCK DPI RAILS CONFIGURATION (Managed by Mahandar)
# ------------------------------------------------------------------------------
# Chaos mode triggers: 'none', 'timeout', '500', 'slow', 'bad_data'
MOCK_CHAOS_MODE=none
MOCK_CHAOS_LATENCY_MS=1500
MOCK_NADRA_AUTO_MATCH_THRESHOLD=0.85
MOCK_RAAST_MAX_DISBURSEMENT_LIMIT=25000.0
MOCK_SERVICES_API_KEY=mock-internal-secret-key-12345

# ------------------------------------------------------------------------------
# 5. DECISION ENGINE THRESHOLDS (Cost Matrix)
# ------------------------------------------------------------------------------
# Wrong approval costs 10x more than slow approval
THRESHOLD_AUTO_APPROVE_MAX_P_WRONG=0.05
THRESHOLD_ASK_MORE_PROOF_MAX_P_WRONG=0.30
MAX_AUTO_APPROVE_AMOUNT=15000.0

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & EVALUATION (Optional)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
